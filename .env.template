# =============================================================================
# Metaculus Forecasting Bot - Environment Configuration
# =============================================================================
#
# Local usage:
#
#   cp .env.template .env
#
# Then replace REPLACE_ME values with your actual credentials.
#
# NEVER commit your .env file to Git.
#
# GitHub Actions:
#
#   Put credentials under:
#   Settings -> Secrets and variables -> Actions -> Secrets
#
#   Put non-secret configuration under:
#   Settings -> Secrets and variables -> Actions -> Variables
#
# =============================================================================


# =============================================================================
# METACULUS
# =============================================================================

# Required.
#
# Your Metaculus bot/account token.
#
METACULUS_TOKEN=REPLACE_ME


# =============================================================================
# HUGGING FACE
# =============================================================================
#
# The main forecasting brain runs through Hugging Face Inference Providers.
#
# Current default:
#
#   Model:    WeiboAI/VibeThinker-3B
#   Provider: featherless-ai
#
# HF_TOKEN is required.
# =============================================================================

# Required.
#
# Hugging Face fine-grained token with permission to make calls to
# Inference Providers.
#
HF_TOKEN=REPLACE_ME

# Main forecasting/reasoning model.
#
# This is separate from the OpenRouter helper models.
#
HF_MAIN_BRAIN_MODEL=WeiboAI/VibeThinker-3B

# Hugging Face Inference Provider.
#
HF_INFERENCE_PROVIDER=featherless-ai


# =============================================================================
# OPENROUTER
# =============================================================================
#
# OpenRouter is used for three helper tasks:
#
#   1. Search-query generation
#   2. Research summarisation
#   3. Parsing the main brain's output into a structured forecast
#
# All three currently use:
#
#   nvidia/nemotron-3-ultra-550b-a55b:free
#
# =============================================================================

# Required.
#
# OpenRouter API key.
#
OPENROUTER_API_KEY=REPLACE_ME


# OpenRouter model used to generate web-search queries.
#
OPENROUTER_QUERY_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free


# OpenRouter model used to summarise scraped research.
#
OPENROUTER_HELPER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free


# OpenRouter model used to parse the main forecasting brain's response
# into the structured prediction expected by forecasting-tools.
#
OPENROUTER_PARSER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free


# =============================================================================
# OPTIONAL RESEARCH PROVIDERS
# =============================================================================
#
# These are optional.
#
# The bot's DDGS + scraping research pipeline does not require these keys.
# =============================================================================


# -----------------------------------------------------------------------------
# AskNews
# -----------------------------------------------------------------------------

# ASKNEWS_CLIENT_ID=REPLACE_ME
# ASKNEWS_SECRET=REPLACE_ME


# -----------------------------------------------------------------------------
# Perplexity
# -----------------------------------------------------------------------------

# PERPLEXITY_API_KEY=REPLACE_ME


# -----------------------------------------------------------------------------
# Exa
# -----------------------------------------------------------------------------

# EXA_API_KEY=REPLACE_ME


# =============================================================================
# OPTIONAL LLM PROVIDERS
# =============================================================================
#
# These are not required for the current VibeThinker + OpenRouter setup.
# =============================================================================

# OPENAI_API_KEY=REPLACE_ME
# ANTHROPIC_API_KEY=REPLACE_ME


# =============================================================================
# OPTIONAL INTEGRATIONS
# =============================================================================

# LIGHTNINGROD_API_KEY=REPLACE_ME
