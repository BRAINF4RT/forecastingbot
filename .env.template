# =============================================================================
# Metaculus Forecasting Bot - OpenRouter configuration
#
# Copy to `.env` for local use. Never commit real API keys.
# =============================================================================

METACULUS_TOKEN=REPLACE_ME
OPENROUTER_API_KEY=REPLACE_ME

# The primary forecast/research model. main.py validates this exact value.
# The runtime fallback chain is configured in code:
#   nvidia/nemotron-3-ultra-550b-a55b:free
#   -> poolside/laguna-s-2.1:free
#   -> qwen/qwen3.8-27b:free
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# Optional integrations from the template. The built-in DDGS research path
# does not require them.
# ASKNEWS_CLIENT_ID=REPLACE_ME
