# =============================================================================
# Metaculus Forecasting Bot - OpenRouter configuration
#
# Copy this file to `.env` when running locally:
#     cp .env.template .env
#
# NEVER commit your real `.env` or API keys.
# =============================================================================

# ---- REQUIRED ----------------------------------------------------------------

# Your Metaculus bot account token.
METACULUS_TOKEN=REPLACE_ME

# Your OpenRouter API key.
# https://openrouter.ai/keys
OPENROUTER_API_KEY=REPLACE_ME


# ---- MODEL -------------------------------------------------------------------

# The bot uses this model for:
#   - forecast reasoning
#   - search-query generation
#   - research summarisation
#   - structured-output parsing
#
# The :free suffix is intentional.
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free


# ---- OPTIONAL RESEARCH PROVIDERS ---------------------------------------------
#
# The built-in DDGS/trafilatura research pipeline works without these.
# Adding one of these can provide additional research capabilities.

# AskNews
# ASKNEWS_CLIENT_ID=REPLACE_ME
# ASKNEWS_SECRET=REPLACE_ME

# Perplexity
# PERPLEXITY_API_KEY=REPLACE_ME

# Exa
# EXA_API_KEY=REPLACE_ME


# ---- OPTIONAL INTEGRATIONS ---------------------------------------------------

# LightningRod
# LIGHTNINGROD_API_KEY=REPLACE_ME
